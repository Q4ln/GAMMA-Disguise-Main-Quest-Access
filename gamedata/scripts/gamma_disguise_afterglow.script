-- GAMMA Disguise Main Quest Access: Operation Afterglow for every faction.
-- Anomaly's PDA news gives the flag that opens Operation Afterglow only when
-- the real faction is a story faction (dynamic_news_manager, IsStoryPlayer).
-- Any other character gets the flag here once Mortal Sin's hero talk is done.

local function unlock_afterglow()
	if IsStoryMode() and not IsStoryPlayer()
		and has_alife_info("mortal_sin_zone_hero")
		and not has_alife_info("operation_afterglow_info_about_done")
	then
		db.actor:give_info_portion("operation_afterglow_info_about_done")
	end
end

local function actor_on_info_callback(_, info_id)
	if info_id == "mortal_sin_zone_hero" then
		unlock_afterglow()
	end
end

function on_game_start()
	RegisterScriptCallback("actor_on_first_update", unlock_afterglow)
	RegisterScriptCallback("actor_on_info_callback", actor_on_info_callback)
end
